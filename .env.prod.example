# Production-only Compose interpolation file.
# Copy to .env.prod, fill in every empty required value with a unique secret,
# and use: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
# Empty required secrets intentionally cause Compose to stop before deployment.
ENVIRONMENT=production
PUBLIC_HOST=
WEB_PORT=80

SECRET_KEY=
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

POSTGRES_USER=scheduler
POSTGRES_DB=scheduler
POSTGRES_PASSWORD=

AI_ENABLED=false
AI_DEFAULT_PROVIDER=mock
SOLVER_WORKERS=2
MAX_CONCURRENT_OPTIMIZATIONS=2
LOG_LEVEL=INFO
