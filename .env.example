# ---------------------------------------------------------------------------
# Intelligent Production Scheduling AI - example environment file
#
# Copy to `.env` in the repository root and adjust.  The backend reads this
# file automatically (see backend/app/config.py).  NEVER commit a real `.env`.
# ---------------------------------------------------------------------------

# --- Application ----------------------------------------------------------
APP_NAME="Intelligent Production Scheduling AI"
ENVIRONMENT=development                 # development | staging | production
DEBUG=false
API_PREFIX=/api
# Comma separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# --- Database -------------------------------------------------------------
# A relative SQLite path is resolved inside the data directory
# (DATA_DIR, default <repo>/data), so this file is <repo>/data/app.db no
# matter which directory the command is started from.  An absolute path is
# used unchanged.
DATABASE_URL=sqlite:///app.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+psycopg://scheduler:scheduler@postgres:5432/scheduler
# The writable state directory (SQLite file, uploads).
# DATA_DIR=./data
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Production Compose (docker-compose.prod.yml) requires these. Uncomment and
# replace each placeholder with a unique high-entropy secret before deploying.
# POSTGRES_USER=scheduler
# POSTGRES_DB=scheduler
# POSTGRES_PASSWORD=replace-with-a-unique-strong-password
# PUBLIC_HOST=scheduler.example.com

# --- Security -------------------------------------------------------------
# CHANGE THIS IN PRODUCTION.  Used to sign JWT access tokens.
SECRET_KEY=dev-insecure-change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=240
RATE_LIMIT_WINDOW_SECONDS=60

# --- Scheduling -----------------------------------------------------------
DEFAULT_HORIZON_DAYS=14
DEFAULT_TIME_LIMIT_SECONDS=20
MAX_TIME_LIMIT_SECONDS=600
# Number of CP-SAT search workers.  Leave it empty to let the backend pick a
# sensible value for the host (two workers minimum, at most eight).
# SOLVER_WORKERS=8
SOLVER_RANDOM_SEED=42
MAX_CONCURRENT_OPTIMIZATIONS=2
JOB_RETENTION_HOURS=48
# Fixed instant used as "now" when planning (ISO-8601).  When it is set, the
# demo factory, the planning horizon and the disruption events all use that
# instant, which makes every benchmark result reproducible.  Leave it empty
# for a demo that always shows the current date.
# PLANNING_REFERENCE=2024-05-13T00:00:00Z

# --- Uploads --------------------------------------------------------------
MAX_UPLOAD_BYTES=5242880
UPLOAD_DIR=./data/uploads

# --- AI -------------------------------------------------------------------
# The scheduler never depends on the AI subsystem.  Set AI_ENABLED=false to
# run completely offline; the deterministic "mock" provider is used instead.
AI_ENABLED=true
AI_DEFAULT_PROVIDER=mock
AI_REQUEST_TIMEOUT_SECONDS=45
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.2
AI_MAX_RETRIES=2
AI_MONTHLY_BUDGET_USD=10
AI_SPEND_LIMIT_USD=25

# --- Observability --------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=false
METRICS_ENABLED=true

# ---------------------------------------------------------------------------
# Optional AI provider credentials
#
# These are NOT read by the scheduler or auto-imported into the AI provider
# store. They are reference values to copy into the AI Settings screen when you
# explicitly add a provider.
#
# A ChatGPT / Claude / Gemini *subscription* does NOT include API access -
# you need a separate API key with its own billing.  See docs/ai.md.
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
#
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
#
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=openai/gpt-4o-mini
#
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.1
#
# CUSTOM_LLM_BASE_URL=https://my-gateway.example.com/v1
# CUSTOM_LLM_API_KEY=...
# CUSTOM_LLM_MODEL=my-model
